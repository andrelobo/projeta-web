{
  "name": "projeta-web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend do PROJETA",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
